+const getFilterFunction = (options) => {
+  switch(typeof options.outputFilter) {
+    case 'function':
+      return options.outputFilter;
+    case 'string':
+      return (entry) => minimatch(entry.sourcePath, options.outputFilter);
+    case 'object':
+      const includes = [];
+      const excludes = [];
+
+      for(const [key, value] of Object.entries(options.outputFilter)) {
+        if(value) {
+          includes.push(key);
+        } else {
+          excludes.push(key);
+        }
